<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <!--  ======================================================================  -->
    <!--  الأذونات المعتمدة لنظام أندرويد (Android APK - حتى أندرويد 16+)              -->
    <!--  ======================================================================  -->
    
    <!--  1. إذن الإشعارات (Android 13+ / API 33)  -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    
    <!--  2. إذن الكاميرا (لقراءة الباركود وإدخال المنتجات)  -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>
    
    <!--  3. إذن الاتصال بالإنترنت والشبكة (للمزامنة السحابية وبوابة المطور)  -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    
    <!--  4. أذونات التخزين والذاكرة الشاملة (لغاية أندرويد 16)  -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>
    
    <!--  5. إذن الاهتزاز والتنبيهات الصوتية  -->
    <uses-permission android:name="android.permission.VIBRATE"/>
    
    <!--  6. إذن المايكروفون والصوتيات  -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>

    <application 
        android:allowBackup="true" 
        android:icon="@mipmap/ic_launcher" 
        android:label="نظام سُند المحاسبي" 
        android:roundIcon="@mipmap/ic_launcher_round" 
        android:supportsRtl="true" 
        android:theme="@style/Theme.SanadAccounting" 
        android:usesCleartextTraffic="true" 
        android:requestLegacyExternalStorage="true">
        
        <activity 
            android:name=".MainActivity" 
            android:exported="true" 
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|layoutDirection" 
            android:label="سُند المحاسبي الذكي" 
            android:theme="@style/Theme.SanadAccounting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!--  مزوّد الملفات الآمن (FileProvider) لتفعيل مشاركة الملفات عبر البلوتوث والواتساب بدون توقف  -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>

    </application>
</manifest>
